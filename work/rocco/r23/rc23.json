{
 "id": "RC-23",
 "title": "Penny Plays Dumb With a Scammer: Part 2",
 "tail": 2.2,
 "hot": [
  "PIE",
  "CARD",
  "FOXES",
  "TAIL",
  "CANCELLED"
 ],
 "lines": [
  [
   "S",
   "[fast] [fake friendly] Hi! Delivery company! Your Black Friday package is STUCK!"
  ],
  [
   "P",
   "[gasps] Oh no! Which package?"
  ],
  [
   "S",
   "[pause] [nervous] ...The... box one!"
  ],
  [
   "R",
   "[whispering] Psst. Play dumb again."
  ],
  [
   "S",
   "[sly] Just pay a tiny fee. Read me the long number on your card."
  ],
  [
   "P",
   "[proud] Okay! Three. Point. One. Four. One. Five. Nine..."
  ],
  [
   "S",
   "[angry] That's PI!"
  ],
  [
   "P",
   "[excited] Ooh, I love pie! Is it pumpkin?"
  ],
  [
   "S",
   "[frustrated] The CARD! Read the CARD!"
  ],
  [
   "P",
   "[reading slowly] It says... 'Penny's piggy bank card. Do not give to foxes.'"
  ],
  [
   "S",
   "[stammering] I'm not a fox! I'm a... delivery guy!"
  ],
  [
   "P",
   "[innocent] Then why is your tail sticking out of the phone?"
  ],
  [
   "R",
   "[whispering] [impressed] ...She's getting scary good at this."
  ],
  [
   "S",
   "[furious] Fine! Your package is CANCELLED!"
  ],
  [
   "P",
   "[cheerful] Good! I didn't order one!"
  ],
  [
   "S",
   "[pause] [defeated] ...Wait. What?"
  ],
  [
   "R",
   "[warmly] Real delivery companies don't call asking for your card. Didn't order it? Nothing to pay. Hang up."
  ]
 ],
