{
 "id": "RC-01",
 "title": "Scammer Calls a Detective. Big Mistake.",
 "structure": "scam-bait call: detective spells a trap",
 "tail": 2.4,
 "hot": [
  "BRENDA",
  "SECURE",
  "STEAL",
  "SAFE",
  "FLAG",
  "BANK"
 ],
 "lines": [
  [
   "S",
   "[sweet] [fast] Hello! This is Brenda. From your bank."
  ],
  [
   "R",
   "[deadpan] Which bank?"
  ],
  [
   "S",
   "[pause] ...Yours."
  ],
  [
   "R",
   "[deadpan] Name it."
  ],
  [
   "S",
   "[nervous] The... big one. With the... money."
  ],
  [
   "P",
   "[whispering] [excited] Ooh! I have that one!"
  ],
  [
   "R",
   "[whispering] Shh."
  ],
  [
   "S",
   "[fast] Sir, there's fraud on your account! I can steal... I mean, SECURE your money. Just move it to a safe account!"
  ],
  [
   "R",
   "[calm] Sure. Write down my account number."
  ],
  [
   "S",
   "[greedy] Ready!"
  ],
  [
   "R",
   "[slowly] R... E... D..."
  ],
  [
   "S",
   "[eager] Mm-hm!"
  ],
  [
   "R",
   "[slowly] F... L... A... G."
  ],
  [
   "S",
   "[confused] Red... flag. Wait, WHAT?!"
  ],
  [
   "R",
   "[deadpan] Read it again. Slowly."
  ],
  [
   "S",
   "[panicked] Uh... bad connection!"
  ],
  [
   "P",
   "[sad] Aww. I liked Brenda."
  ],
  [
   "R",
   "[deadpan] Real banks never ask you to move your money. Hang up. Call the number on your card."
  ]
 ],
