  ],
  [
   "R",
   "[warmly] Your move: buy it only in the console store."
  ],
  [
   "P",
   "[curious] Wait... and the FREE one?"
  ],
  [
   "R",
   "[deadpan] Free cheese... [pause] mousetrap."
  ],
  [
   "P",
   "[nervous laugh] ...I'm deleting it."
  ]
