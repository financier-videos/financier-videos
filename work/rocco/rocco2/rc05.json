 "lines": [
  [
   "S",
   "[fast] [fake serious] This is your bank's fraud department! Your account is in DANGER!"
  ],
  [
   "P",
   "[gasps] Oh no! Which bank?"
  ],
  [
   "S",
   "[pause] [nervous] ...Your... bank!"
  ],
  [
   "R",
   "[whispering] Psst. Play dumb."
  ],
  [
   "S",
   "[sly] We just texted you a six-digit code. Read it to me."
  ],
  [
   "P",
   "[confident] Six!"
  ],
  [
   "S",
   "[confused] ...What?"
  ],
  [
   "P",
   "[cheerful] It has six digits! You said so!"
  ],
  [
   "S",
   "[frustrated] The NUMBERS! Read me the numbers!"
  ],
  [
   "P",
   "[fast] [proud] One, two, three, four, five, six!"
  ],
  [
   "S",
   "[angry] Not COUNTING! The code on your screen!"
  ],
  [
   "P",
   "[reading] It says: do not share this code with anyone. [pause] Are you... anyone?"
  ],
  [
   "S",
   "[stammering] I'm... I'm the BANK!"
  ],
  [
   "P",
   "[innocent] The bank sent this text. So the bank says: don't tell YOU."
  ],
  [
   "R",
   "[whispering] [impressed] ...She's good."
  ],
  [
   "S",
   "[furious] That's it! I'm calling the police!"
  ],
  [
   "P",
   "[cheerful] Great! Tell them your name!"
  ],
  [
   "S",
   "[panicked] Uh... wrong number!"
  ],
  [
   "R",
   "[warmly] Real banks never ask for your code. Hang up and call the number on your card."
  ]
 ],
