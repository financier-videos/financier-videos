 "lines": [
  [
   "S",
   "[smooth, fake official] Hello! Bank fraud department. Read me your card number, please."
  ],
  [
   "P",
   "[whispering, nervous] Rocco... the bank wants my card number."
  ],
  [
   "R",
   "[whispering, sly] Give him this one. Slowly."
  ],
  [
   "P",
   "[slow, careful] Okay... R."
  ],
  [
   "S",
   "[writing] R. Got it."
  ],
  [
   "P",
   "[slowly] E... D."
  ],
  [
   "S",
   "[writing, impatient] E, D. Go on, go on."
  ],
  [
   "P",
   "[trying not to laugh] F... L... A... G."
  ],
  [
   "S",
   "[proud] Perfect! R, E, D... F, L, A, G."
  ],
  [
   "S",
   "[realizing, horrified] ...Wait. RED FLAG?!"
  ],
  [
   "R",
   "[deadpan] Banks never ask for your card number on a call. Hang up."
  ],
  [
   "S",
   "[whiny] Not again!"
  ]
 ],
